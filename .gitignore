# =============================================================================
# Pokemon TCG AI Battle Competition — Hardened .gitignore
# =============================================================================

# --- Official competition data & assets (non-redistributable per rules) ---
ptcg_engine/
sample_submission/
Card_ID List_EN.pdf
Card_ID List_JP.pdf
EN_Card_Data.csv
JP_Card_Data.csv
card_data.json

# --- Build, Staging & Disposable Runtime Artifacts ---
build/
dist/
runs/
submission.tar.gz
/*.tar.gz

# --- Python Environments & Caches ---
venv/
.venv/
env/
test_env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# --- Scratch, Logs & Temporary Dumps ---
scratchpad/
*.log
*.tmp
*.temp
episode-*.json

# --- Large Datasets & Replay Corpora ---
data/*
!data/README_DATA.md
!data/MANIFEST.csv
analysis/**/replays_*/
stage4/data/replays_*/
stage4/data/bc_v2/
stage4/rl_ours/runs/

# --- Credentials & Secrets Prevention ---
kaggle.json
credentials.json
.env
.env.*
!.env.example
*.key
*.pem
id_rsa
id_ed25519

# --- Local IDE & Tool Configuration ---
.claude/settings.local.json
/cg/
